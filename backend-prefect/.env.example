# Pooler de Supabase en modo SESIÓN (5432), el mismo proyecto de Afirmative Pill.
# Las tablas del laboratorio viven en el schema mfa_lab.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-us-west-2.pooler.supabase.com:5432/postgres"

# Firma de los JWT (pre_auth_token y access_token). python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET="cambia-esto"

# Clave Fernet para cifrar el secreto TOTP en reposo.
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY="cambia-esto"

# Pepper para el HMAC de los códigos de respaldo.
BACKUP_CODE_PEPPER="cambia-esto"

# Los flows reportan al servidor local de Prefect (`prefect server start`).
PREFECT_API_URL="http://127.0.0.1:4200/api"
